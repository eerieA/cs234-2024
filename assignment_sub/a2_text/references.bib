@misc{wikipedia_fubinis_2025,
	title = {Fubini's theorem},
	copyright = {Creative Commons Attribution-ShareAlike License},
	url = {https://en.wikipedia.org/w/index.php?title=Fubini%27s_theorem&oldid=1288910840},
	abstract = {In mathematical analysis, Fubini's theorem characterizes the conditions under which it is possible to compute a double integral by using an iterated integral. It was introduced by Guido Fubini in 1907. Although Fubini's theorem for infinite series is a special case of the more general Fubini's theorem, it is not necessarily appropriate to characterize the former as being proven by the latter because the properties of measures needed to prove Fubini's theorem proper, in particular subadditivity of measure, may be proven using Fubini's theorem for infinite series.},
	language = {en},
	urldate = {2025-06-05},
	journal = {Wikipedia},
	month = may,
	year = {2025},
	note = {Page Version ID: 1288910840},
}
